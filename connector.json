  "tools": [
    {
      "name": "zoho_list_leads",
      "description": "Read a page of leads with an explicit field selection.",
      "method": "GET",
      "path": "/Leads",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fields": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fields"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "page": "page",
          "per_page": "per_page",
          "fields": "fields"
        },
        "body": {}
      },
      "sampleArguments": {
        "page": 1,
        "per_page": 10,
        "fields": "Last_Name,Company,Email"
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://raw.githubusercontent.com/zoho/crm-oas/main/v8.0/record/record.yaml"
      ]
    },
    {
      "name": "zoho_create_lead",
      "description": "Create one lead; CRM-specific mandatory fields and validation still apply.",
      "method": "POST",
      "path": "/Leads",
      "readOnly": false,
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Last_Name": {
                  "type": "string",
                  "minLength": 1
                },
                "Company": {
                  "type": "string",
                  "minLength": 1
                },
                "Email": {
                  "type": "string",
                  "format": "email"
                },
                "First_Name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "Last_Name",
                "Company"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1
          }
        },
        "required": [
          "records"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "records": "data"
        }
      },
      "sampleArguments": {
        "records": [
          {
            "Last_Name": "Example",
            "Company": "Sandbox Company",
            "Email": "sandbox@example.com"
          }
        ]
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "provenance": [
        "https://raw.githubusercontent.com/zoho/crm-oas/main/v8.0/record/record.yaml"
      ]
    }
  ],
  "workflow": {
    "name": "Zoho CRM authorized workflow",
    "description": "Review lead records and explicitly create an authorized new lead in a US-region CRM.",
    "steps": [
      "zoho_list_leads",
