{
  "openapi": "3.1.0",
  "info": {
    "title": "Zoho CRM selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://www.zohoapis.com/crm/v8"
    }
  ],
  "paths": {
    "/Leads": {
      "get": {
        "operationId": "zoho_list_leads",
        "summary": "Read a page of leads with an explicit field selection.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "zoho_create_lead",
        "summary": "Create one lead; CRM-specific mandatory fields and validation still apply.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "Last_Name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "Company": {
                          "type": "string",
                          "minLength": 1
                        },
                        "Email": {
                          "type": "string",
                          "format": "email"
                        },
                        "First_Name": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "Last_Name",
                        "Company"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 1
                  }
                },
                "required": [
                  "data"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
